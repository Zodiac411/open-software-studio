{
  "$id": "studio://schemas/v2/REPAIR_PACKAGE.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authority": {
      "type": "string"
    },
    "document_id": {
      "pattern": "^[A-Z][A-Z0-9-]+$",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "project_id": {
      "pattern": "^PRJ-[A-Z0-9-]+$",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "type": "string"
    },
    "verification": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "verified",
        "partial",
        "unverified",
        "not-applicable"
      ]
    },
    "version": {
      "pattern": "^2\\.",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "repair_id",
    "accepted_findings",
    "allowed_paths",
    "forbidden_paths",
    "required_behavior",
    "regression_proof",
    "evidence",
    "non_goals",
    "repair_budget",
    "stop_conditions"
  ],
  "title": "Studio V2 REPAIR_PACKAGE artifact",
  "type": "object"
}
