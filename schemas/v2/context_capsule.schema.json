{
  "$id": "studio://schemas/v2/CONTEXT_CAPSULE.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned Studio V2 artifact contract; unknown top-level fields are rejected.",
  "properties": {
    "acceptance": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "active_goal": {
      "minLength": 1,
      "type": "string"
    },
    "allowed_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "committed_diff_stat": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "decisions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "dirty_diff_stat": {
      "minLength": 1,
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "forbidden_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^PRJ-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "project.project_id"
    },
    "proof": {
      "minLength": 1,
      "type": "string"
    },
    "repository": {
      "minLength": 1,
      "type": "string"
    },
    "requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "x-studio-reference": "product_spec.requirements"
    },
    "reviewed_state": {
      "additionalProperties": true,
      "type": "object"
    },
    "schema": {
      "minLength": 1,
      "type": "string"
    },
    "scope_budget": {
      "additionalProperties": true,
      "type": "object"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "snapshot_id": {
      "minLength": 1,
      "pattern": "^SNAP-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "snapshot.snapshot_id"
    },
    "sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "APPROVED",
        "FROZEN",
        "IN_PROGRESS",
        "PROVING",
        "IN_REVIEW",
        "ACCEPTED",
        "CLOSED",
        "RELEASED",
        "PASS",
        "PASS_WITH_LIMITATIONS",
        "BLOCKED",
        "NOT_RUN",
        "UNPROVEN"
      ],
      "type": "string"
    },
    "stop_conditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "verification": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": "2.0.0",
      "type": "string"
    },
    "wp_id": {
      "minLength": 1,
      "pattern": "^WP-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "work_package.wp_id"
    }
  },
  "required": [
    "document_id",
    "wp_id",
    "snapshot_id",
    "active_goal",
    "requirements",
    "decisions",
    "scope_budget",
    "allowed_paths",
    "forbidden_paths",
    "acceptance",
    "proof",
    "stop_conditions"
  ],
  "title": "Studio V2 CONTEXT_CAPSULE artifact",
  "type": "object",
  "x-studio-version": "2.0.0"
}
