{
  "$id": "studio://schemas/v2/work_package.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned Studio V2 artifact contract; unknown top-level fields are rejected.",
  "properties": {
    "acceptance": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "allowed_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "base_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "committed_diff_stat": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "dirty_diff_stat": {
      "minLength": 1,
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "forbidden_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "handoff_requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "implementer_actor_id": {
      "minLength": 1,
      "type": "string"
    },
    "implementer_session_id": {
      "minLength": 1,
      "type": "string"
    },
    "non_goals": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "primary_outcome": {
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^PRJ-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "project.project_id"
    },
    "repository": {
      "minLength": 1,
      "type": "string"
    },
    "requirement_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "x-studio-reference": "product_spec.requirements"
    },
    "reviewed_state": {
      "additionalProperties": true,
      "type": "object"
    },
    "rollback": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "minLength": 1,
      "type": "string"
    },
    "scope_budget": {
      "additionalProperties": false,
      "properties": {
        "new_dependencies": {
          "minimum": 0,
          "type": "integer"
        },
        "primary_outcomes": {
          "minimum": 1,
          "type": "integer"
        },
        "subsystems": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "primary_outcomes",
        "subsystems",
        "new_dependencies"
      ],
      "type": "object"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "snapshot_id": {
      "pattern": "^SNAP-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "APPROVED",
        "FROZEN",
        "IN_PROGRESS",
        "PROVING",
        "IN_REVIEW",
        "ACCEPTED",
        "CLOSED",
        "RELEASED",
        "PASS",
        "PASS_WITH_LIMITATIONS",
        "BLOCKED",
        "NOT_RUN",
        "UNPROVEN"
      ],
      "type": "string"
    },
    "stop_conditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "verification": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "minLength": 1,
            "type": "string"
          },
          "level": {
            "enum": [
              "E0",
              "E1",
              "E2",
              "E3",
              "E4",
              "E5"
            ],
            "type": "string"
          }
        },
        "required": [
          "level",
          "command"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "const": "2.0.0",
      "type": "string"
    },
    "wp_id": {
      "minLength": 1,
      "pattern": "^WP-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "work_package.wp_id"
    }
  },
  "required": [
    "document_id",
    "wp_id",
    "status",
    "snapshot_id",
    "base_sha",
    "primary_outcome",
    "requirements",
    "allowed_paths",
    "forbidden_paths",
    "scope_budget",
    "acceptance",
    "verification",
    "non_goals",
    "stop_conditions",
    "rollback",
    "handoff_requirements",
    "implementer_actor_id",
    "implementer_session_id",
    "requirement_digest"
  ],
  "title": "Studio V2 work package contract",
  "type": "object",
  "x-studio-version": "2.0.0"
}
