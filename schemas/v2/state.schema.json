{
  "$id": "studio://schemas/v2/state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "active_wp": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority": {
      "type": "string"
    },
    "current_sha": {
      "pattern": "^([0-9a-f]{40})?$",
      "type": [
        "string",
        "null"
      ]
    },
    "document_id": {
      "pattern": "^[A-Z][A-Z0-9-]+$",
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "project_id": {
      "pattern": "^PRJ-[A-Z0-9-]+$",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "type": "string"
    },
    "verification": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "verified",
        "partial",
        "unverified",
        "not-applicable"
      ]
    },
    "version": {
      "pattern": "^2\\.",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "phase",
    "status",
    "active_wp",
    "current_sha",
    "next_action"
  ],
  "title": "Studio V2 state projection",
  "type": "object"
}
