{
  "$id": "studio://schemas/v2/state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned Studio V2 artifact contract; unknown top-level fields are rejected.",
  "properties": {
    "active_wp": {
      "pattern": "^WP-[A-Z0-9-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "archetype": {
      "minLength": 1,
      "type": "string"
    },
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "blocking_items": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "committed_diff_stat": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "current_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": [
        "string",
        "null"
      ]
    },
    "dirty_diff_stat": {
      "minLength": 1,
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "live_head_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "minLength": 1,
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "INTAKE",
        "SHAPED",
        "PLANNED",
        "FROZEN",
        "IMPLEMENTING",
        "PROVING",
        "IN_REVIEW",
        "REPAIR",
        "ACCEPTED",
        "CLOSED",
        "RELEASED"
      ],
      "type": "string"
    },
    "profile": {
      "enum": [
        "lite",
        "standard",
        "full"
      ],
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^PRJ-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "project.project_id"
    },
    "proof": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "release_candidate_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "minLength": 1,
      "type": "string"
    },
    "reviewed_state": {
      "additionalProperties": true,
      "type": "object"
    },
    "schema": {
      "minLength": 1,
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^SNAP-[A-Z0-9-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "source_checkpoint_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "APPROVED",
        "FROZEN",
        "IN_PROGRESS",
        "PROVING",
        "IN_REVIEW",
        "ACCEPTED",
        "CLOSED",
        "RELEASED",
        "PASS",
        "PASS_WITH_LIMITATIONS",
        "BLOCKED",
        "NOT_RUN",
        "UNPROVEN"
      ],
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    },
    "verification": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": "2.0.0",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "phase",
    "status",
    "active_wp",
    "current_sha",
    "next_action"
  ],
  "title": "Studio V2 state projection",
  "type": "object",
  "x-studio-version": "2.0.0"
}
