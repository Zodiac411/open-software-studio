{
  "$id": "studio://schemas/v2/ARCHITECTURE.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned Studio V2 artifact contract; unknown top-level fields are rejected.",
  "properties": {
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "boundaries": {
      "minLength": 1,
      "type": "string"
    },
    "chosen_architecture": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "dependencies": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "document_id": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "failure_recovery": {
      "minLength": 1,
      "type": "string"
    },
    "options": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^PRJ-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "project.project_id"
    },
    "quality_attributes": {
      "minLength": 1,
      "type": "string"
    },
    "repository": {
      "minLength": 1,
      "type": "string"
    },
    "reviewed_state": {
      "additionalProperties": true,
      "type": "object"
    },
    "revisit_triggers": {
      "minLength": 1,
      "type": "string"
    },
    "rollback": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "minLength": 1,
      "type": "string"
    },
    "security": {
      "minLength": 1,
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "APPROVED",
        "FROZEN",
        "IN_PROGRESS",
        "PROVING",
        "IN_REVIEW",
        "ACCEPTED",
        "CLOSED",
        "RELEASED",
        "PASS",
        "PASS_WITH_LIMITATIONS",
        "BLOCKED",
        "NOT_RUN",
        "UNPROVEN"
      ],
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "verification": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "verified_current_architecture": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "const": "2.0.0",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "verified_current_architecture",
    "boundaries",
    "quality_attributes",
    "options",
    "chosen_architecture",
    "failure_recovery",
    "security",
    "dependencies",
    "rollback",
    "revisit_triggers"
  ],
  "title": "Studio V2 ARCHITECTURE artifact",
  "type": "object",
  "x-studio-version": "2.0.0"
}
