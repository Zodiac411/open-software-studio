{
  "$id": "studio://schemas/v2/PROJECT_BRIEF.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned Studio V2 artifact contract; unknown top-level fields are rejected.",
  "properties": {
    "assumptions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "constraints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "desired_outcome": {
      "minLength": 1,
      "type": "string"
    },
    "disposition": {
      "enum": [
        "ACCEPT",
        "REPAIR",
        "REJECT",
        "BLOCKED",
        "UNPROVEN"
      ],
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "non_goals": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "parked_ideas": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "primary_outcome": {
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^PRJ-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "project.project_id"
    },
    "repository": {
      "minLength": 1,
      "type": "string"
    },
    "reviewed_state": {
      "additionalProperties": true,
      "type": "object"
    },
    "schema": {
      "minLength": 1,
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "solution_ladder": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "APPROVED",
        "FROZEN",
        "IN_PROGRESS",
        "PROVING",
        "IN_REVIEW",
        "ACCEPTED",
        "CLOSED",
        "RELEASED",
        "PASS",
        "PASS_WITH_LIMITATIONS",
        "BLOCKED",
        "NOT_RUN",
        "UNPROVEN"
      ],
      "type": "string"
    },
    "target_actor": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "verification": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": "2.0.0",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "project_id",
    "primary_outcome",
    "target_actor",
    "desired_outcome",
    "constraints",
    "non_goals",
    "assumptions",
    "parked_ideas",
    "solution_ladder",
    "disposition"
  ],
  "title": "Studio V2 PROJECT_BRIEF artifact",
  "type": "object",
  "x-studio-version": "2.0.0"
}
