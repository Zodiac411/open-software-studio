{
  "$id": "studio://schemas/v2/RETRO_DISTILLATION.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned Studio V2 artifact contract; unknown top-level fields are rejected.",
  "properties": {
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "decisions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "document_id": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "friction": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "measured_evidence": {
      "minLength": 1,
      "type": "string"
    },
    "next_actions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "outcomes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^PRJ-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "project.project_id"
    },
    "sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "APPROVED",
        "FROZEN",
        "IN_PROGRESS",
        "PROVING",
        "IN_REVIEW",
        "ACCEPTED",
        "CLOSED",
        "RELEASED",
        "PASS",
        "PASS_WITH_LIMITATIONS",
        "BLOCKED",
        "NOT_RUN",
        "UNPROVEN"
      ],
      "type": "string"
    },
    "verification": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": "2.0.0",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "outcomes",
    "friction",
    "measured_evidence",
    "decisions",
    "next_actions"
  ],
  "title": "Studio V2 RETRO_DISTILLATION artifact",
  "type": "object",
  "x-studio-version": "2.0.0"
}
