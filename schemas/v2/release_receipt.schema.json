{
  "$id": "studio://schemas/v2/release_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned Studio V2 artifact contract; unknown top-level fields are rejected.",
  "properties": {
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "committed_diff_stat": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "dirty_diff_stat": {
      "minLength": 1,
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "evidence": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "owner_approval": {
      "minLength": 1,
      "type": "string"
    },
    "package_digests": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^PRJ-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "project.project_id"
    },
    "repository": {
      "minLength": 1,
      "type": "string"
    },
    "requirement_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "review_id": {
      "minLength": 1,
      "pattern": "^REV-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "independent_review.review_id"
    },
    "reviewed_state": {
      "additionalProperties": true,
      "type": "object"
    },
    "revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "rollback": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "minLength": 1,
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "APPROVED",
        "FROZEN",
        "IN_PROGRESS",
        "PROVING",
        "IN_REVIEW",
        "ACCEPTED",
        "CLOSED",
        "RELEASED",
        "PASS",
        "PASS_WITH_LIMITATIONS",
        "BLOCKED",
        "NOT_RUN",
        "UNPROVEN"
      ],
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "verification": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "pattern": "^2\\.",
      "type": "string"
    },
    "waivers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "version",
    "revision",
    "review_id",
    "requirement_digest",
    "package_digests",
    "environment",
    "evidence",
    "limitations",
    "waivers",
    "rollback",
    "owner_approval"
  ],
  "title": "Studio V2 release receipt contract",
  "type": "object",
  "x-studio-version": "2.0.0"
}
