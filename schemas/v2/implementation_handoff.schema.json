{
  "$id": "studio://schemas/v2/IMPLEMENTATION_HANDOFF.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authority": {
      "type": "string"
    },
    "document_id": {
      "pattern": "^[A-Z][A-Z0-9-]+$",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "project_id": {
      "pattern": "^PRJ-[A-Z0-9-]+$",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "type": "string"
    },
    "verification": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "verified",
        "partial",
        "unverified",
        "not-applicable"
      ]
    },
    "version": {
      "pattern": "^2\\.",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "wp_id",
    "base_sha",
    "head_sha",
    "branch",
    "claimed_outcomes",
    "files",
    "commands",
    "evidence",
    "scope_delta",
    "unproven",
    "next_action",
    "reviewer_action"
  ],
  "title": "Studio V2 IMPLEMENTATION_HANDOFF artifact",
  "type": "object"
}
