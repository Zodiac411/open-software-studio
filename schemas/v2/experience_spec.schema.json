{
  "$id": "studio://schemas/v2/EXPERIENCE_SPEC.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned Studio V2 artifact contract; unknown top-level fields are rejected.",
  "properties": {
    "accessibility": {
      "minLength": 1,
      "type": "string"
    },
    "actor": {
      "minLength": 1,
      "type": "string"
    },
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "components": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "document_id": {
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "fallback": {
      "minLength": 1,
      "type": "string"
    },
    "flow": {
      "minLength": 1,
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^PRJ-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string",
      "x-studio-reference": "project.project_id"
    },
    "responsive": {
      "minLength": 1,
      "type": "string"
    },
    "sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "states": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "APPROVED",
        "FROZEN",
        "IN_PROGRESS",
        "PROVING",
        "IN_REVIEW",
        "ACCEPTED",
        "CLOSED",
        "RELEASED",
        "PASS",
        "PASS_WITH_LIMITATIONS",
        "BLOCKED",
        "NOT_RUN",
        "UNPROVEN"
      ],
      "type": "string"
    },
    "verification": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": "2.0.0",
      "type": "string"
    },
    "visual_qa": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "actor",
    "flow",
    "states",
    "components",
    "responsive",
    "accessibility",
    "fallback",
    "visual_qa"
  ],
  "title": "Studio V2 EXPERIENCE_SPEC artifact",
  "type": "object",
  "x-studio-version": "2.0.0"
}
